.env
data/
# data/ above is the runtime DB volume; the painting module's bundled data
# (canonical paint-line metadata) must ship with the app.
!backend/app/painting/data/
frontend/node_modules/
frontend/dist/
frontend/coverage/
desktop/coverage/
node_modules/
__pycache__/
*.pyc
.DS_Store
.claude/
# Generated GitHub Wiki output (built by scripts/wiki/build_wiki.py)
_wiki_build/
AGENTS.md

# Reorganize/import undo logs (written next to the DB; test artifacts)
reorg_undo_*.log
backend/reorg_undo_*.log
bulk_import_report.csv
corpus_validation_report.csv

# Auto-generated Fernet key for encrypting secrets at rest (app/services/secrets.py).
# Falls back to cwd when DATABASE_URL isn't a resolvable sqlite file path (e.g.
# running pytest/uvicorn from backend/), so it can appear outside data/ too.
.secret_key
backend/.secret_key

# machine-local Norton SSL-inspection workaround — see backend/Dockerfile.local
# and frontend/Dockerfile.local
*.pem
docker-compose.override.yml
Dockerfile.local
stl/

# uv writes this stub when a uv-created venv is used in backend/ (see
# backend/.venv/pyvenv.cfg). The project installs from requirements.txt
# everywhere and backend/pyproject.toml has no [project] table, so the lock
# is empty and machine-local. Drop this line if the project ever adopts uv.
backend/uv.lock

# Python virtual environments. Not path-scoped: any directory in the repo.
# uv-created venvs self-ignore via their own .venv/.gitignore, but a plain
# `python -m venv` does not, so the repo needs its own rule.
venv/
.venv/
